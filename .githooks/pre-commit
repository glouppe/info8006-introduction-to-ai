#!/usr/bin/env bash
# Keep what the README links in step with what is committed: the PDF of every
# staged slide deck, and the archive of every staged project folder.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

decks=$(git diff --cached --name-only --diff-filter=ACMR -- 'lecture*.md' course-syllabus.md closing.md)

if [ -n "$decks" ]; then
    echo "pre-commit: exporting PDFs for" $decks >&2
    pdfs=$(uv run --no-project --with playwright python scripts/export_pdf.py $decks)
    git add $pdfs
fi

# grep finds nothing when no project file is staged, which pipefail turns into
# a failure of the hook, hence the `|| true`
folders=$(git diff --cached --name-only --diff-filter=ACMRD -- 'projects/project*' 'python-tutorial/tutorial_code' \
          | grep -E '^(projects/project[^./]+|python-tutorial/tutorial_code)/' \
          | cut -d/ -f1-2 | sort -u || true)

if [ -n "$folders" ]; then
    echo "pre-commit: rebuilding the archives of" $folders >&2
    zips=$(uv run --no-project python scripts/build_zips.py $folders)
    [ -n "$zips" ] && git add $zips
fi

exit 0
