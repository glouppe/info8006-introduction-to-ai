%   \maketitle
%
%   \begin{recap}
%       \topic{Chain rule}
%       Any joint distribution ... \term{defined term} ...
%   \end{recap}
%
%   \begin{exercises}[1, 2, 3, 5]    % the exercises done in session, optional
%       \titledquestion{Bag of coins}
%
%       Statement ...
%       \begin{parts}
%           \part Sub-question ...
