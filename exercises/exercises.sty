%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Sections: recap, exercises, quiz %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Section heading: centered small caps between two rules
\newcommand*{\exercises@heading}[1]{%
    \par\bigskip\medskip\needspace{6\baselineskip}%
    \noindent
    \leaders\vrule height 3.6pt depth -3.1pt\hfill
    \quad{\large\scshape\textls[100]{#1}}\quad
    \leaders\vrule height 3.6pt depth -3.1pt\hfill
    \null\par
    \nopagebreak\vspace{1.1\baselineskip}%
}

% Theory recap, in the notation of the slides
\newenvironment{recap}{%
    \exercises@heading{Recap}%
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0.5\baselineskip}%
}{%
    \par
}

% A topic of the recap
\newcommand*{\topic}[1]{%
    \par\medskip\needspace{4\baselineskip}%
    {\bfseries #1\par}%
    \nopagebreak
}

% A term defined in the recap
\newcommand*{\term}[1]{\emph{#1}}

% Exercises, on a new page; the optional argument lists the exercises done in session
\newenvironment{exercises}[1][]{%
    \clearpage
    \exercises@heading{Exercises}%
    \ifx\relax#1\relax\else
        \noindent\textit{In session:} exercises #1.\par\medskip
    \fi
    \begin{questions}%
}{%
    \end{questions}%
}

% Multiple choice questions, formatted as in the exams: \item for each question,
% then \begin{enumerate}[label=$\bigcirc$] for its choices. In the exams, these lists
% sit inside a question, itself a list: an invisible list with no margin gives them
% the same depth, hence the same spacing and indentation.
\newenvironment{quiz}{%
    \exercises@heading{Quiz}%
    \setlist[enumerate, 2]{beginpenalty=10000, midpenalty=10000}% keep a question with its choices
    \interlinepenalty=\@M % and its lines and displayed formulas together
    \predisplaypenalty=\@M
    \postdisplaypenalty=\@M
    \list{}{%
        \setlength{\leftmargin}{0pt}%
        \setlength{\labelwidth}{0pt}%
        \setlength{\itemindent}{0pt}%
        \setlength{\topsep}{0pt}%
    }%
    \item\relax
    \begin{enumerate}%
}{%
    \end{enumerate}%
    \endlist
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Exercises and their parts %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% The title of an exercise goes on its own line: leave a blank line after \titledquestion{...}
\qformat{\large\bfseries Exercise \thequestion\quad\thequestiontitle\hfill}

% The source of an exercise, in its title: \aima{12} for Russell and Norvig (the chapter of
% the 4th edition, whose exercises are online only and not numbered), \source{CS188, Fall 2019}
% or \source{Exam, January 2019} otherwise
\newcommand*{\source}[1]{{\mdseries(#1)}}
\newcommand*{\aima}[1]{\source{AIMA ch.~#1}}

% A group of exercises inside the exercises section, before its first exercise:
% \exercisegroup{Supplementary exercises}. Centered small caps, kept with that exercise.
% A list refuses paragraphs before its first item (\par and \everypar check it), even in
% a box: the heading uses the primitive \@@par in a box, and checks the space left on the
% page itself, as \needspace would, without starting a paragraph.
\newcommand*{\exercisegroup}[1]{%
    \penalty-100
    \begingroup
        \dimen@=12\baselineskip
        \dimen@ii=\pagegoal
        \advance\dimen@ii-\pagetotal
        \ifdim\dimen@>\dimen@ii
            \ifdim\dimen@ii>\z@\vfil\fi
            \penalty-\@M
        \fi
    \endgroup
    \vspace{\medskipamount}%
    \vbox{\everypar{}\let\par\@@par\centering\scshape\textls[80]{#1}\@@par}%
    \nopagebreak
}

% The exam class defines \titledquestion inside the questions environment, before
% running this hook: wrap it there, to keep an exercise title with the first lines
% of its statement.
\renewcommand{\questionshook}{%
    \setlength{\leftmargin}{0pt}%
    \setlength{\labelwidth}{-\labelsep}%
    \setlength{\topsep}{0pt}%
    \setlength{\itemsep}{\bigskipamount}%
    \let\exercises@titledquestion\titledquestion
    \def\titledquestion##1{\needspace{6\baselineskip}\global\exercises@paras=2 \exercises@titledquestion{##1}}%
}

% Keep a part label, (a), with the first lines of the part. The exam class defines \part
% inside the parts environment, before running this hook. An exercise that opens with
% its parts, without a statement, also keeps its title with part (a): a counter, set by
% \titledquestion and decreased by every paragraph, tells whether a statement came first.
\newcount\exercises@paras
\AddToHook{para/begin}{\global\advance\exercises@paras\m@ne}
\renewcommand{\partshook}{%
    \ifnum\exercises@paras>0 \@beginparpenalty=\@M\fi
    \let\exercises@part\part
    \def\part{%
        \ifnum\exercises@paras>0
            \global\exercises@paras=0
        \else
            \needspace{3\baselineskip}%
        \fi
        \@beginparpenalty=\@lowpenalty
        \exercises@part}%
}

%%%%%%%%%%%%%
% Solutions %
%%%%%%%%%%%%%

% As in the exams: unframed, in color
\ifx\NOSOL\undefined
    \printanswers
\else
    \noprintanswers
\fi

\colorlet{SolutionColor}{blue!75!black}
\unframedsolutions
\SolutionEmphasis{\color{SolutionColor}}
\renewcommand{\solutiontitle}{\noindent\textit{Solution.}\enspace}

% Printed solutions are plain paragraphs. The exam class passes even unframed solutions
% through its frame machinery, which forces a page break before a solution that does not
% fit, leaving the question it answers alone at the bottom of the page. Here a solution
% stays with the text it answers, and "Solution." with a list, a centered figure or a
% table that opens it.
\renewenvironment{TheSolution}{%
    \par\nopagebreak
    \vspace{\parskip}%
    \leftskip=0pt
    \rightskip=0pt
    \solutiontitle
    \ignorespaces
}{%
    \unskip\par
}
\AddToHook{env/solution/begin}{\@beginparpenalty=\@M}

% The correct choice of a multiple choice question: in the solutions, its circle is filled
% (drawn over the $\bigcirc$ label, measured from it) and its text is in the solution color.
% Start the paragraph before switching color: a color switch in vertical mode leaves a whatsit
% after which the page can break, separating the choice from the previous ones.
\newlength{\exercises@tickwd}
\newlength{\exercises@tickht}
\newcommand*{\exercises@tick}{%
    \sbox\z@{$\bigcirc$}%
    \setlength{\exercises@tickwd}{\wd\z@}%
    \setlength{\exercises@tickht}{\dimexpr\ht\z@+\dp\z@\relax}%
    \llap{%
        \tikz[baseline=\dp\z@]{%
            \path[use as bounding box] (0, 0) rectangle (\exercises@tickwd, \exercises@tickht);
            \fill[SolutionColor] (0.5\exercises@tickwd, 0.5\exercises@tickht) circle[radius=0.36\exercises@tickwd];
        }%
        \hskip\labelsep
    }%
}
\newcommand{\correct}[1]{\ifprintanswers\leavevmode\exercises@tick{\color{SolutionColor}#1}\else#1\fi}

